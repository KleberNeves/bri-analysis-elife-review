  "concat": [
    {
      "title": {
        "text": "A. Registered Labs",
        "anchor": "start",
        "fontSize": 18,
        "fontWeight": "bold",
        "offset": 8
      },
      "width": 340,
      "height": 255,
      "data": {
        "url": "https://raw.githubusercontent.com/fititnt/gis-dataset-brasil/master/uf/topojson/uf.json",
        "format": {
          "type": "topojson",
          "feature": "uf"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "name": "panel_a_counts"
            },
            "key": "id",
            "fields": [
              "n",
              "centroid"
            ]
          }
        },
        {
          "calculate": "datum.centroid[0]",
          "as": "longitude"
        },
        {
          "calculate": "datum.centroid[1]",
          "as": "latitude"
        }
      ],
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "stroke": "black",
            "strokeWidth": 0.7
          },
          "encoding": {
            "color": {
              "field": "n",
              "type": "quantitative",
              "scale": {
                "range": [
                  "#F7FBFF",
                  "#9ECAE1",
                  "#6BAED6",
                  "#4292C6",
                  "#2171B5",
                  "#08519C",
                  "#08306B"
                ],
                "type": "threshold",
                "domain": [
                  1,
                  3,
                  5,
                  10,
                  15,
                  20
                ]
              },
              "legend": {
                "title": "Count",
                "titleAlign": "center",
                "titleFontSize": 14,
                "labelFontSize": 11,
                "orient": "right"
              }
            },
            "tooltip": [
              {
                "field": "properties.name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Count",
                "format": "d"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": "bold",
            "dy": -5
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "n",
              "type": "quantitative",
              "format": "d"
            },
            "color": {
              "condition": [
                {
                  "test": "datum.n === 0",
                  "value": "transparent"
                },
                {
                  "test": "datum.n >= 10",
                  "value": "white"
                }
              ],
              "value": "black"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "B. Included Labs",
